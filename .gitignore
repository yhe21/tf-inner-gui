# Python environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
.ultralytics/

# IDE and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Runtime captures and training outputs
*.pt
captures/
error_records/
runs/
data/

# Deploy these two NCNN models with the application so Raspberry Pi updates
# need only `git pull`. Other local model exports remain ignored.
models/*
!models/inner_cls_ncnn_model/
!models/inner_cls_ncnn_model/**
!models/glue_cls_ncnn_model/
!models/glue_cls_ncnn_model/**
models/**/__pycache__/

# Local classification images are intentionally not committed to Git.
# Keep only the empty directory structure used by the training tools.
datasets/**
!datasets/**/
!datasets/**/.gitkeep
