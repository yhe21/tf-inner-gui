QMainWindow,
QWidget#centralWidget {
    background-color: #eef3f8;
    color: #172033;
    font-size: 18px;
}

QFrame#headerFrame,
QFrame#footerFrame {
    background-color: #ffffff;
    border: 1px solid #d8e0e8;
    border-radius: 12px;
}

QLabel#lblTitle {
    color: #12345b;
    font-size: 28px;
    font-weight: 700;
}

QLabel#lblVt6Status,
QLabel#lblCameraStatus {
    min-width: 140px;
    padding: 8px 12px;
    color: #9a3412;
    background-color: #fff1e8;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 600;
}

QLabel#lblVt6Status[statusOk="true"],
QLabel#lblCameraStatus[statusOk="true"] {
    color: #166534;
    background-color: #dcfce7;
}

QLabel#lblClock {
    color: #475569;
    font-size: 16px;
    font-weight: 600;
}

QPushButton[menuButton="true"] {
    color: #ffffff;
    background-color: #2367a8;
    border: 3px solid #ffffff;
    border-radius: 18px;
    font-size: 30px;
    font-weight: 700;
    padding: 18px;
}

QPushButton[menuButton="true"]:pressed {
    background-color: #174a7b;
    border-color: #9dc8ef;
}

QPushButton#btnCameraMonitor {
    background-color: #087f8c;
}

QPushButton#btnCameraMonitor:pressed {
    background-color: #075d66;
}

QLabel#lblFooter {
    color: #475569;
    font-size: 17px;
    font-weight: 600;
}

QPushButton#btnExit {
    color: #ffffff;
    background-color: #b42318;
    border: none;
    border-radius: 10px;
    font-size: 19px;
    font-weight: 700;
}

QPushButton#btnExit:pressed {
    background-color: #7a271a;
}

QMessageBox {
    background-color: #ffffff;
    font-size: 18px;
}

QMessageBox QPushButton {
    min-width: 110px;
    min-height: 48px;
    font-size: 18px;
}

QDialog#AdjustmentDialog {
    background-color: #eef3f8;
    color: #172033;
}

QLabel#lblDialogTitle {
    color: #12345b;
    font-size: 30px;
    font-weight: 700;
}

QLabel#lblStep,
QLabel#lblRangeInfo {
    color: #475569;
    font-size: 18px;
    font-weight: 600;
}

QFrame#adjustmentFrame {
    background-color: #ffffff;
    border: 1px solid #d8e0e8;
    border-radius: 14px;
    padding: 12px;
}

QLabel#lblAxisX,
QLabel#lblAxisY,
QLabel#lblAxisZ,
QLabel#lblAxisU {
    min-width: 70px;
    color: #12345b;
    font-size: 30px;
    font-weight: 800;
}

QLabel[valueDisplay="true"] {
    min-width: 210px;
    min-height: 64px;
    color: #172033;
    background-color: #f8fafc;
    border: 2px solid #cbd5e1;
    border-radius: 10px;
    font-size: 28px;
    font-weight: 700;
}

QPushButton[adjustButton="true"] {
    min-width: 120px;
    min-height: 64px;
    color: #ffffff;
    background-color: #2367a8;
    border: none;
    border-radius: 12px;
    font-size: 38px;
    font-weight: 800;
}

QPushButton[adjustButton="true"]:pressed {
    background-color: #174a7b;
}

QPushButton[adjustButton="true"]:disabled {
    color: #94a3b8;
    background-color: #dbe3ea;
}

QPushButton#btnCancel,
QPushButton#btnApply {
    border: none;
    border-radius: 10px;
    font-size: 20px;
    font-weight: 700;
}

QPushButton#btnCancel {
    color: #334155;
    background-color: #dbe3ea;
}

QPushButton#btnApply {
    color: #ffffff;
    background-color: #16803c;
}

QPushButton#btnCancel:pressed {
    background-color: #c3ced8;
}

QPushButton#btnApply:pressed {
    background-color: #11632f;
}

QDialog#CameraMonitorDialog {
    background-color: #eef3f8;
    color: #172033;
}

QLabel#lblCameraPageTitle {
    color: #12345b;
    font-size: 30px;
    font-weight: 700;
}

QLabel#lblCaptureMode {
    padding: 8px 14px;
    color: #075d66;
    background-color: #d9f3f5;
    border-radius: 8px;
    font-size: 17px;
    font-weight: 700;
}

QFrame#cameraImageFrame {
    background-color: #172033;
    border: 2px solid #334155;
    border-radius: 14px;
}

QFrame#inspectionResultsFrame {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
}

QLabel#lblInspectionStatus {
    color: #475569;
    font-size: 15px;
    font-weight: 600;
}

QLabel#lblInspectionStatus[statusOk="true"] {
    color: #166534;
}

QLabel#lblInnerResult,
QLabel#lblGlueResult {
    padding: 5px 8px;
    color: #475569;
    background-color: #f1f5f9;
    border: 1px solid #cbd5e1;
    border-radius: 7px;
    font-size: 16px;
    font-weight: 700;
}

QLabel#lblInnerResult[inspectionState="OK"],
QLabel#lblGlueResult[inspectionState="OK"] {
    color: #166534;
    background-color: #dcfce7;
    border-color: #86efac;
}

QLabel#lblInnerResult[inspectionState="NG"],
QLabel#lblGlueResult[inspectionState="NG"],
QLabel#lblInnerResult[inspectionState="ERROR"],
QLabel#lblGlueResult[inspectionState="ERROR"] {
    color: #991b1b;
    background-color: #fee2e2;
    border-color: #fca5a5;
}

QLabel#lblCapturedImage {
    color: #cbd5e1;
    background-color: #0f172a;
    border-radius: 8px;
    font-size: 20px;
    font-weight: 600;
}

QLabel#lblCameraPageStatus {
    color: #475569;
    font-size: 17px;
    font-weight: 600;
}

QCheckBox#chkSaveProductionImages {
    min-height: 48px;
    padding: 4px 12px;
    color: #12345b;
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    font-size: 19px;
    font-weight: 700;
}

QCheckBox#chkSaveProductionImages::indicator {
    width: 30px;
    height: 30px;
}

QPushButton#btnCameraBack,
QPushButton#btnAutoExposure,
QPushButton#btnManualCapture {
    border: none;
    border-radius: 10px;
    font-size: 20px;
    font-weight: 700;
}

QPushButton#btnCameraBack {
    color: #334155;
    background-color: #dbe3ea;
}

QPushButton#btnManualCapture {
    color: #ffffff;
    background-color: #087f8c;
}

QPushButton#btnAutoExposure {
    color: #ffffff;
    background-color: #2367a8;
}

QPushButton#btnCameraBack:pressed {
    background-color: #c3ced8;
}

QPushButton#btnManualCapture:pressed {
    background-color: #075d66;
}

QPushButton#btnAutoExposure:pressed {
    background-color: #174a7b;
}

QPushButton#btnCameraBack:disabled,
QPushButton#btnAutoExposure:disabled,
QPushButton#btnManualCapture:disabled {
    color: #94a3b8;
    background-color: #dbe3ea;
}
